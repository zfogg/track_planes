[Unit]
Description=ADS-B Exchange Feeder
After=network.target readsb.service
Requires=readsb.service
BindsTo=readsb.service

[Service]
Type=simple
User=adsbexchange
WorkingDirectory=/usr/local/share/adsbexchange/git
EnvironmentFile=/etc/default/adsbexchange
ExecStart=/usr/local/share/adsbexchange/git/scripts/adsbexchange-feed.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
