# Track Planes ADS-B Feeder Credentials
# Copy this file to .env and fill in your credentials

# OpenSky Network (https://opensky-network.org/)
OPENSKY_USERNAME=your_username
OPENSKY_SERIAL=serial_number_generated_on_first_run
OPENSKY_LAT=39.09725
OPENSKY_LONG=-77.01173
OPENSKY_ALT=46

# ADSBHub (https://www.adsbhub.org/)
# Get CLIENTKEY from your ADSBHub account settings
ADSBHUB_STATION_KEY=

# Timezone
TZ=America/New_York
